# ---------------------------------------------------------------------------
# Tidewell — environment variables (local dev / standalone docker compose)
# Copy to `.env` and fill in. NEVER commit real secrets.
# On the LoupMr NAS use deploy/tidewell.env.example instead.
# ---------------------------------------------------------------------------

# Postgres (matches docker-compose service `db`, published on host port 5434)
POSTGRES_USER=tidewell
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=tidewell
DATABASE_URL="postgresql://tidewell:change-me-strong@localhost:5434/tidewell?schema=public"

# Auth.js session signing — openssl rand -base64 32
AUTH_SECRET="generate-me"
# Public base URL. Also used to build OAuth redirect URIs:
#   ${AUTH_URL}/api/connect/{microsoft|google|github}/callback
AUTH_URL="http://localhost:3020"

# Encrypts OAuth tokens at rest (AES-256-GCM) — openssl rand -base64 32
# Changing it later just means everyone reconnects their accounts.
ENCRYPTION_KEY="generate-me-too"

# Who can create an account: open | invite | closed
# (the very first account can always be created and becomes admin)
REGISTRATION_MODE=open
# For invite mode: comma-separated emails allowed to register
REGISTRATION_ALLOWLIST=

# Sync tuning
SYNC_INTERVAL_MINUTES=5
SYNC_DAYS_AHEAD=30
# SYNC_DISABLED=true          # turn off the built-in scheduler
# CRON_SECRET=                # enables POST /api/cron/sync for external triggers

# --- OAuth apps (see docs/INTEGRATIONS.md). Leave blank to hide a provider. ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
