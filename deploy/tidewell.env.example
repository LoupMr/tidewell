# ---------------------------------------------------------------------------
# Copy to  SC-Nexus/tidewell.env  on the NAS (next to docker-compose.yml) and
# replace every CHANGE-ME. Read by both `tidewell-db` and `tidewell`.
# ---------------------------------------------------------------------------
POSTGRES_USER=tidewell
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=tidewell
# Host MUST be the container name `tidewell-db`, same user/password/db as above
DATABASE_URL=postgresql://tidewell:CHANGE-ME@tidewell-db:5432/tidewell?schema=public

AUTH_SECRET=CHANGE-ME            # openssl rand -base64 32
AUTH_URL=https://tidewell.lothmar.com
ENCRYPTION_KEY=CHANGE-ME         # openssl rand -base64 32  (different from AUTH_SECRET)

REGISTRATION_MODE=open           # open | invite | closed
REGISTRATION_ALLOWLIST=

SYNC_INTERVAL_MINUTES=5
SYNC_DAYS_AHEAD=30

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
